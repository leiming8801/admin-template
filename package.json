{
  "name": "admin-template",
  "version": "1.0.0",
  "private": true,
  "description": "可复用的后台管理系统模板",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "dev:server": "turbo run dev --filter=@admin-template/server",
    "dev:web": "turbo run dev --filter=@admin-template/web",
    "build:server": "turbo run build --filter=@admin-template/server",
    "build:web": "turbo run build --filter=@admin-template/web",
    "db:generate": "turbo run db:generate --filter=@admin-template/server",
    "db:push": "turbo run db:push --filter=@admin-template/server",
    "db:seed": "turbo run db:seed --filter=@admin-template/server",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "rimraf": "^5.0.5"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18.0.0"
  }
}

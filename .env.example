# Environment
NODE_ENV=development

# Database
DATABASE_URL="mysql://user:password@localhost:3306/admin_template"

# JWT - 后台管理员（以下示例仅限开发，生产启动会拒绝）
JWT_SECRET="local-development-access-secret-change-before-production"
JWT_ACCESS_EXPIRES="2h"
JWT_REFRESH_SECRET="local-development-refresh-secret-change-before-production"
JWT_REFRESH_EXPIRES="7d"

# JWT - C端会员 [预留，当前不使用]
JWT_MEMBER_SECRET="local-development-member-access-secret-not-currently-used"
JWT_MEMBER_ACCESS_EXPIRES="7d"
JWT_MEMBER_REFRESH_SECRET="local-development-member-refresh-secret-not-currently-used"
JWT_MEMBER_REFRESH_EXPIRES="30d"

# Server
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Frontend（直连后端时填服务源地址，不追加 /api；使用代理时留空）
VITE_API_BASE_URL="http://localhost:3000"
